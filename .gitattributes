#
# Fixtures and golden files are compared byte for byte, so they keep LF line
# endings on every OS. Without this, a Windows checkout (core.autocrlf)
# rewrites them to CRLF and the comparisons fail.
*.dcv text eol=lf
tests/golden/** text eol=lf
*.nc text eol=lf
crates/dreamcarve/tests/expected/** text eol=lf
# Bundled post-processor definitions are pinned by hash (#106).
crates/dc-project/src/definitions/**/*.json text eol=lf
# The Fusion fixture's JSON is zipped byte for byte into sample.tools, and a
# test compares the two; the zip itself is binary.
tests/fixtures/fusion/*.json text eol=lf
*.tools binary
