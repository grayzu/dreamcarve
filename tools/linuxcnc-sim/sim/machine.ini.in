# SPDX-License-Identifier: Apache-2.0
#
# The simulated machine `tools/linuxcnc-sim` runs (issue #328): three
# linear axes, millimetres, trivial kinematics. `src/config.rs` fills in
# each placeholder (a name between at signs) for the session it runs; see
# `Machine` there.
#
# Homing has no switches: HOME_SEARCH_VEL = 0 and HOME_LATCH_VEL = 0 home
# a joint where it is and set it to HOME ([JOINT_<num>], INI
# configuration document). The velocities and accelerations are far
# above any feed, so motion is limited by the program's feeds and the
# feed override, not by the machine. The section keys are LinuxCNC's
# (https://linuxcnc.org/docs/html/config/ini-config.html).

[EMC]
VERSION = 1.1
MACHINE = dreamcarve-sim
DEBUG = 0

[DISPLAY]
DISPLAY = ./dreamcarve-ui.py
MAX_FEED_OVERRIDE = 100

[DREAMCARVE]
HOME = @HOME@
LOGGER = @LOGGER@
# Percent, as linuxcncrsh's set feed_override takes it: 100 times the
# programmed feeds, the most MAX_FEED_OVERRIDE (a factor) allows.
FEED_OVERRIDE = 10000
TIMEOUT = 300
PORT = 5007

[TASK]
TASK = milltask
CYCLE_TIME = 0.001

[RS274NGC]
PARAMETER_FILE = sim.var
@STARTUP@

[EMCMOT]
@EMCMOT@
# Generous, so a loaded host does not time task out waiting on motion.
COMM_TIMEOUT = 30.0
BASE_PERIOD = 0
SERVO_PERIOD = 1000000

[EMCIO]
EMCIO = io
CYCLE_TIME = 0.100
TOOL_TABLE = tool.tbl

[HAL]
HALFILE = @HALFILE@

[TRAJ]
COORDINATES = X Y Z
LINEAR_UNITS = mm
ANGULAR_UNITS = degree
DEFAULT_LINEAR_VELOCITY = 10000
MAX_LINEAR_VELOCITY = 10000
DEFAULT_LINEAR_ACCELERATION = 1000000
MAX_LINEAR_ACCELERATION = 1000000

[KINS]
KINEMATICS = trivkins
JOINTS = 3

[AXIS_X]
MAX_VELOCITY = 10000
MAX_ACCELERATION = 1000000
MIN_LIMIT = -500
MAX_LIMIT = 1000

[AXIS_Y]
MAX_VELOCITY = 10000
MAX_ACCELERATION = 1000000
MIN_LIMIT = -500
MAX_LIMIT = 1000

[AXIS_Z]
MAX_VELOCITY = 10000
MAX_ACCELERATION = 1000000
MIN_LIMIT = @Z_MIN@
MAX_LIMIT = @Z_MAX@

[JOINT_0]
TYPE = LINEAR
HOME = 0
MAX_VELOCITY = 10000
MAX_ACCELERATION = 1000000
MIN_LIMIT = -500
MAX_LIMIT = 1000
FERROR = 1000
MIN_FERROR = 1000
HOME_SEARCH_VEL = 0
HOME_LATCH_VEL = 0
HOME_SEQUENCE = 0

[JOINT_1]
TYPE = LINEAR
HOME = 0
MAX_VELOCITY = 10000
MAX_ACCELERATION = 1000000
MIN_LIMIT = -500
MAX_LIMIT = 1000
FERROR = 1000
MIN_FERROR = 1000
HOME_SEARCH_VEL = 0
HOME_LATCH_VEL = 0
HOME_SEQUENCE = 0

[JOINT_2]
TYPE = LINEAR
HOME = @Z_MAX@
MAX_VELOCITY = 10000
MAX_ACCELERATION = 1000000
MIN_LIMIT = @Z_MIN@
MAX_LIMIT = @Z_MAX@
FERROR = 1000
MIN_FERROR = 1000
HOME_SEARCH_VEL = 0
HOME_LATCH_VEL = 0
HOME_SEQUENCE = 0
