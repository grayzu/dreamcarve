{
  "id": "grblhal",
  "name": "grblHAL",
  "description": "grblHAL - Enhanced 32-bit port of GRBL with WCS support",
  "vendor": null,
  "builtin": true,
  "coordinate_system": {
    "x_axis": "X",
    "y_axis": "Y",
    "z_axis": "Z"
  },
  "number_format": {
    "trailing_zeros": true,
    "leading_zero": true
  },
  "units": {
    "mm_command": "G21",
    "inch_command": "G20"
  },
  "program": {
    "header": [
      "( Project: {programName} )",
      "( Generated by DreamCarve on {date} )",
      "G90",
      "G17",
      "G94",
      "{unitsCommand}",
      "{wcsCommand}"
    ],
    "operation_header": [
      "( Operation {operationIndex}: {operationName} )",
      "( Tool {toolNumber}: {toolName} )"
    ],
    "footer": [
      "M5"
    ],
    "comment_prefix": "(",
    "comment_suffix": ")",
    "line_numbers": false,
    "line_number_increment": 10
  },
  "work_coordinates": {
    "select_command": "G54",
    "machine_command": "G53"
  },
  "motion": {
    "rapid_command": "G0",
    "linear_command": "G1",
    "cw_arc_command": "G2",
    "ccw_arc_command": "G3",
    "arc_format": "ij",
    "modal_motion": true,
    "arc_interpolation": true
  },
  "feed_speed": {
    "feed_command": "F",
    "rpm_command": "S",
    "spindle_on_cw": "M3",
    "spindle_on_ccw": "M4",
    "spindle_off": "M5",
    "inline_with_motion": true,
    "modal_feed_speed": true,
    "spindle_on_dwell": {
      "command": "G4 P{seconds}",
      "units": "seconds"
    }
  },
  "tool_change": {
    "commands": [
      "M5",
      "T{toolNumber} M6"
    ],
    "stop_spindle_first": true,
    "pause_after_change": false,
    "pause_command": "M0"
  },
  "canned_cycles": null,
  "coolant": {
    "flood_on_command": "M8",
    "mist_on_command": "M7",
    "coolant_off_command": "M9"
  },
  "stop": {
    "program_end_command": "M30"
  },
  "default_settings": {
    "file_extension": "nc",
    "spindle_control": "automatic",
    "spindle_on_dwell_s": 3.0,
    "tool_change_mode": "separate_programs",
    "decimal_places": {
      "mm": 3,
      "inch": 4
    },
    "use_canned_cycles": false
  }
}
