{
  "id": "grbl",
  "name": "GRBL 1.1",
  "description": "GRBL 1.1 - common hobby CNC controller (Arduino-based)",
  "vendor": null,
  "builtin": true,
  "coordinate_system": {
    "x_axis": "X",
    "y_axis": "Y",
    "z_axis": "Z"
  },
  "number_format": {
    "trailing_zeros": true,
    "leading_zero": true
  },
  "units": {
    "mm_command": "G21",
    "inch_command": "G20"
  },
  "program": {
    "header": [
      "; {programName}",
      "; Generated by DreamCarve on {date}",
      "G90",
      "G17",
      "G94",
      "{unitsCommand}"
    ],
    "operation_header": [
      "; Operation {operationIndex}: {operationName}",
      "; Tool {toolNumber}: {toolName}"
    ],
    "footer": [
      "M5"
    ],
    "comment_prefix": ";",
    "comment_suffix": "",
    "line_numbers": false,
    "line_number_increment": 10
  },
  "work_coordinates": {
    "select_command": "G54"
  },
  "motion": {
    "rapid_command": "G0",
    "linear_command": "G1",
    "cw_arc_command": "G2",
    "ccw_arc_command": "G3",
    "arc_format": "ij",
    "modal_motion": true,
    "arc_interpolation": true
  },
  "feed_speed": {
    "feed_command": "F",
    "rpm_command": "S",
    "spindle_on_cw": "M3",
    "spindle_on_ccw": "M4",
    "spindle_off": "M5",
    "inline_with_motion": true,
    "modal_feed_speed": true,
    "spindle_on_dwell": {
      "command": "G4 P{seconds}"
    }
  },
  "tool_change": {
    "commands": [
      "M5",
      "M0 ; Tool change: T{toolNumber} {toolName}"
    ],
    "stop_spindle_first": true,
    "pause_after_change": false,
    "pause_command": "M0"
  },
  "canned_cycles": null,
  "coolant": null,
  "stop": {
    "program_end_command": "M30"
  },
  "default_settings": {
    "file_extension": "nc",
    "spindle_control": "automatic",
    "spindle_on_dwell_s": 3.0,
    "tool_change_mode": "separate_programs",
    "decimal_places": {
      "mm": 3,
      "inch": 4
    }
  }
}
