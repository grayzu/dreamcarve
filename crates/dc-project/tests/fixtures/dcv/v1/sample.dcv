{
  "version": 1,
  "name": "Sample",
  "display_units": "mm",
  "flatten_tolerance_mm": 0.01,
  "stock": {
    "width_mm": 100.0,
    "height_mm": 100.0,
    "thickness_mm": 6.0
  },
  "origin": {
    "xy": {
      "kind": "bottom_left"
    },
    "z": "stock_top"
  },
  "definitions": {
    "d1": {
      "id": "d1",
      "name": "Rectangle",
      "profiles": [
        {
          "vertices": [
            {
              "x": 0.0,
              "y": 0.0,
              "bulge": 0.0
            },
            {
              "x": 50.0,
              "y": 0.0,
              "bulge": 0.0
            },
            {
              "x": 50.0,
              "y": 30.0,
              "bulge": 0.0
            },
            {
              "x": 0.0,
              "y": 30.0,
              "bulge": 0.0
            }
          ],
          "closed": true
        }
      ]
    }
  },
  "instances": [
    {
      "id": "i1",
      "definition": "d1",
      "transform": [
        1.0,
        0.0,
        0.0,
        1.0,
        10.0,
        10.0
      ],
      "name": "Rectangle 1",
      "visible": true,
      "locked": false,
      "z_top_mm": 6.0,
      "z_bottom_mm": 0.0
    }
  ],
  "tools": [
    {
      "id": "t1",
      "name": "6.35 mm upcut",
      "cutter": {
        "kind": "end_mill"
      },
      "diameter_mm": 6.35,
      "flutes": 2,
      "feed_mm_min": 1000.0,
      "plunge_mm_min": 300.0,
      "rpm": 18000,
      "step_down_mm": 2.0,
      "step_over_fraction": 0.4
    }
  ],
  "operations": [
    {
      "kind": "profile",
      "id": "o1",
      "name": "Cut out",
      "enabled": true,
      "targets": [
        "i1"
      ],
      "tool": "t1",
      "side": "outside",
      "depth_mm": 6.0,
      "step_down_mm": null,
      "direction": "climb",
      "through_cut_allowance_mm": 0.0,
      "safe_z_mm": 5.0,
      "tabs": {
        "placement": {
          "kind": "count",
          "count": 4
        },
        "width_mm": 6.0,
        "height_mm": 2.0,
        "shape": "rect"
      }
    }
  ],
  "post_processor": {
    "id": "grbl",
    "name": "GRBL 1.1",
    "description": "GRBL 1.1 - common hobby CNC controller (Arduino-based)",
    "vendor": null,
    "builtin": true,
    "file_extension": "nc",
    "coordinate_system": {
      "x_axis": "X",
      "y_axis": "Y",
      "z_axis": "Z"
    },
    "number_format": {
      "decimal_places": {
        "mm": 3,
        "inch": 4
      },
      "trailing_zeros": true,
      "leading_zero": true
    },
    "units": {
      "mm_command": "G21",
      "inch_command": "G20"
    },
    "program": {
      "header": [
        "; {programName}",
        "; Generated by DreamCarve on {date}",
        "G90",
        "G17",
        "G94",
        "{unitsCommand}"
      ],
      "operation_header": [
        "; Operation {operationIndex}: {operationName}",
        "; Tool {toolNumber}: {toolName}"
      ],
      "footer": [
        "M5"
      ],
      "comment_prefix": ";",
      "comment_suffix": "",
      "line_numbers": false,
      "line_number_increment": 10
    },
    "work_coordinates": {
      "select_command": "G54"
    },
    "motion": {
      "rapid_command": "G0",
      "linear_command": "G1",
      "cw_arc_command": "G2",
      "ccw_arc_command": "G3",
      "arc_format": "ij",
      "modal_motion": true,
      "arc_interpolation": true
    },
    "feed_speed": {
      "feed_command": "F",
      "rpm_command": "S",
      "spindle_on_cw": "M3",
      "spindle_on_ccw": "M4",
      "spindle_off": "M5",
      "inline_with_motion": true,
      "modal_feed_speed": true
    },
    "tool_change": {
      "commands": [
        "M5",
        "M0 ; Tool change: T{toolNumber} {toolName}"
      ],
      "stop_spindle_first": true,
      "pause_after_change": false,
      "pause_command": "M0"
    },
    "canned_cycles": null,
    "coolant": null,
    "stop": {
      "program_end_command": "M30"
    }
  }
}
